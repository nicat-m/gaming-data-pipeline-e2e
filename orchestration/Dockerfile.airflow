# Custom Airflow image for the Gaming Lakehouse pipeline.
#
# The stock apache/airflow image has no dbt, no Kafka client and no boto3,
# so the DAG's tasks (dbt run/test, Kafka consumer, RustFS writes) could not
# run inside the orchestrator. Everything is pinned to the same versions as
# requirements.txt so host and orchestrator environments agree.
#
# Built automatically by `docker compose up -d` (see the `build:` key on
# the airflow-* services in infra/docker-compose.yml).
FROM apache/airflow:2.10.2-python3.11

COPY requirements.txt /tmp/requirements.txt

# dbt is deliberately NOT in requirements.txt (it is only needed inside the
# orchestrator image); the rest of the pins match the host environment.
RUN pip install --no-cache-dir \
    "dbt-core==1.8.7" \
    "dbt-clickhouse==1.8.1" \
    && grep -v -e '^\s*#' -e '^\s*$' /tmp/requirements.txt \
      > /tmp/requirements-airflow.txt \
    && pip install --no-cache-dir -r /tmp/requirements-airflow.txt
