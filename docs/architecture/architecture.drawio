<mxfile host="app.diagrams.net"><diagram name="Architecture" id="arch"><mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n2" value="&lt;b&gt;① Davamlı axın&lt;/b&gt;&lt;br&gt;(Airflow-dan kənar, həmişə işləyir)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FAFAFA;strokeColor=#BDBDBD;dashed=1;verticalAlign=top;fontSize=13;" vertex="1" parent="1"><mxGeometry x="20" y="20" width="260" height="760" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;② Airflow DAG: gaming_pipeline&lt;/b&gt; — batch, logical date &lt;b&gt;{{ ds }}&lt;/b&gt; · @daily · retries 2 · tək-tək task, açıq asılılıq" style="shape=label;image=https://cdn.simpleicons.org/apacheairflow/017CEE;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F3F8FF;strokeColor=#1565C0;verticalAlign=top;align=left;spacingLeft=60;fontSize=13;" vertex="1" parent="1"><mxGeometry x="300" y="440" width="1700" height="640" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Python generator&lt;/b&gt;&lt;br&gt;sintetik oyun event-ləri&lt;br&gt;5% çirkli, 2% schema drift" style="shape=label;image=https://cdn.simpleicons.org/python/3776AB;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="220" height="90" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Source PostgreSQL&lt;/b&gt;&lt;br&gt;source.game_events (OLTP)&lt;br&gt;wal_level=logical" style="shape=label;image=https://cdn.simpleicons.org/postgresql/4169E1;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="260" width="220" height="90" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Debezium&lt;/b&gt; (Kafka Connect)&lt;br&gt;WAL oxuyur (pgoutput)&lt;br&gt;hər INSERT → JSON" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;fillColor=#FFF3E0;strokeColor=#E65100;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="220" height="90" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Apache Kafka&lt;/b&gt;&lt;br&gt;topic: gaming.source.&lt;br&gt;game_events (KRaft)" style="shape=label;image=https://cdn.simpleicons.org/apachekafka/231F20;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="220" height="100" as="geometry"/></mxCell><mxCell id="n8" value="INSERT&lt;br&gt;(db_writer.py)" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n4" target="n5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n9" value="WAL&lt;br&gt;(logical replication)" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n5" target="n6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n10" value="JSON zərf&lt;br&gt;{before, after, op}" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n6" target="n7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n11" value="&lt;b&gt;1. land_raw_kafka_to_rustfs&lt;/b&gt;&lt;br&gt;Python consumer (retry 2×, 1dq)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="360" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;2. load_raw_to_clickhouse&lt;/b&gt;&lt;br&gt;clickhouse-connect" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;3. dbt_run_staging&lt;/b&gt;&lt;br&gt;dbt-clickhouse" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;4. dbt_test_staging&lt;/b&gt;&lt;br&gt;DQ qapısı (fail → run failed)" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;5. dbt_run_curated&lt;/b&gt;&lt;br&gt;dim + fact" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;6. publish_serving&lt;/b&gt;&lt;br&gt;view + CSV" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E3F2FD;strokeColor=#1565C0;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1710" y="620" width="200" height="80" as="geometry"/></mxCell><mxCell id="n17" value="" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#1565C0;strokeWidth=2" edge="1" parent="1" source="n11" target="n12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n18" value="" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#1565C0;strokeWidth=2" edge="1" parent="1" source="n12" target="n13"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n19" value="" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#1565C0;strokeWidth=2" edge="1" parent="1" source="n13" target="n14"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n20" value="" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#1565C0;strokeWidth=2" edge="1" parent="1" source="n14" target="n15"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n21" value="" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;dashed=1;strokeColor=#1565C0;strokeWidth=2" edge="1" parent="1" source="n15" target="n16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n22" value="&lt;b&gt;spark_connectivity_proof&lt;/b&gt;&lt;br&gt;(paralel) real S3A işi: Phase 3 📋" style="shape=label;image=https://cdn.simpleicons.org/apachespark/E25A1C;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#F5F5F5;strokeColor=#9E9E9E;dashed=1;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1690" y="470" width="260" height="80" as="geometry"/></mxCell><mxCell id="n24" value="poll → batch 200&lt;br&gt;(consumer group)" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#2E7D32" edge="1" parent="1" source="n7" target="n11"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n25" value="&lt;b&gt;RustFS&lt;/b&gt; (S3) raw zona&lt;br&gt;raw/game_events/dt=&amp;lt;ds&amp;gt;/&lt;br&gt;&amp;lt;first&amp;gt;-&amp;lt;last&amp;gt;.jsonl" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;shape=cylinder3;boundedLbl=1;size=8;" vertex="1" parent="1"><mxGeometry x="360" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;ClickHouse&lt;/b&gt; raw.game_events&lt;br&gt;ReplacingMergeTree&lt;br&gt;ORDER BY (date, event_id)" style="shape=label;image=https://cdn.simpleicons.org/clickhouse/FFCC01;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="630" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;staging.stg_game_events&lt;/b&gt;&lt;br&gt;tipli VIEW (FINAL)" style="shape=label;image=https://cdn.simpleicons.org/clickhouse/FFCC01;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="900" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;DQ yoxlamaları&lt;/b&gt;&lt;br&gt;not_null · unique&lt;br&gt;accepted_values · row count&amp;gt;0" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFEBEE;strokeColor=#C62828;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1170" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;curated&lt;/b&gt;&lt;br&gt;dim_player&lt;br&gt;fct_in_game_transaction" style="shape=label;image=https://cdn.simpleicons.org/clickhouse/FFCC01;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1440" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;serving&lt;/b&gt;&lt;br&gt;v_player_engagement_daily&lt;br&gt;+ CSV (RustFS dt=&amp;lt;ds&amp;gt;)" style="shape=label;image=https://cdn.simpleicons.org/clickhouse/FFCC01;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="1710" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Apache Superset&lt;/b&gt;&lt;br&gt;dashboard (6 chart)&lt;br&gt;:8088" style="shape=label;image=https://cdn.simpleicons.org/apachesuperset/20A6C9;imageWidth=34;imageHeight=34;imageAlign=left;imageVerticalAlign=middle;spacingLeft=46;align=left;rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#E8F5E9;strokeColor=#2E7D32;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="2100" y="820" width="200" height="100" as="geometry"/></mxCell><mxCell id="n32" value="yazır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#1565C0;strokeWidth=1;dashed=1" edge="1" parent="1" source="n11" target="n25"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n33" value="yazır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#1565C0;strokeWidth=1;dashed=1" edge="1" parent="1" source="n12" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n34" value="yazır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#1565C0;strokeWidth=1;dashed=1" edge="1" parent="1" source="n13" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n35" value="yazır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#1565C0;strokeWidth=1;dashed=1" edge="1" parent="1" source="n15" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n36" value="yazır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#1565C0;strokeWidth=1;dashed=1" edge="1" parent="1" source="n16" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n37" value="yoxlayır" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;;strokeColor=#C62828;strokeWidth=1;dashed=1" edge="1" parent="1" source="n14" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n38" value="oxu NDJSON" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n25" target="n26"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n39" value="tipləşdir" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n26" target="n27"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n40" value="test" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n27" target="n28"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n41" value="keçdi → qur" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n28" target="n29"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n42" value="join" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n29" target="n30"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n43" value="SQL (HTTP 8123)" style="endArrow=classic;html=1;rounded=1;fontSize=11;strokeWidth=2;labelBackgroundColor=#FFFFFF;strokeColor=#2E7D32;strokeWidth=3;" edge="1" parent="1" source="n30" target="n31"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="n44" value="&lt;b&gt;Necə parse olur?&lt;/b&gt;&lt;br&gt;Mesaj = Debezium JSON zərfi. Consumer onu dəyişmədən NDJSON-a yazır. Açar offset aralığıdır → təkrar run eyni faylın üstünə yazır." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="360" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n45" value="rec['after'] çıxarılır. UUID sütunlar uuid-ə çevrilir (pozuq → NULL). Debezium DATE (epoch-days) string qalır. &lt;b&gt;Idempotent:&lt;/b&gt; həmin ds partisiyası silinir + event_id dedup." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="630" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n46" value="event_time_raw regex ilə yoxlanır → parseDateTimeBestEffort. Pozuq → NULL (bayraq, sətir atılmır). epoch-days → Date. FINAL ilə dublikat gizlənir." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="900" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n47" value="Biri uğursuzdursa task fail olur, run &lt;b&gt;failed&lt;/b&gt;, curated və serving &lt;b&gt;skip&lt;/b&gt;. Qəsdən xəta: PIPELINE_FAIL_SWITCH=1." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1170" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n48" value="dim_player: argMax (son dəyər, SCD1). fct: yalnız in_game_transaction və event_time NOT NULL. Tam rebuild → idempotent." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1440" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n49" value="Oyunçu × ölkə üzrə count/sum. CREATE OR REPLACE VIEW + deterministik CSV açarı." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="1710" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n50" value="Bağlantı &lt;b&gt;seed skriptindən&lt;/b&gt; yaranır (.env-dən), əl ilə klik yoxdur. Chart-lar serving/staging/curated oxuyur." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="2100" y="950" width="200" height="110" as="geometry"/></mxCell><mxCell id="n51" value="&lt;b&gt;Legend&lt;/b&gt;&lt;br&gt;yaşıl = həyata keçirilib ✅&lt;br&gt;boz qırıq xətt = planlaşdırılıb 📋&lt;br&gt;mavi = Airflow task&lt;br&gt;qırmızı = DQ qapısı&lt;br&gt;qalın yaşıl ox = data axını&lt;br&gt;nazik qırıq ox = asılılıq / yazma" style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFFFF;strokeColor=#BDBDBD;align=left;spacing=8;verticalAlign=top;" vertex="1" parent="1"><mxGeometry x="340" y="200" width="300" height="150" as="geometry"/></mxCell><mxCell id="n52" value="&lt;b style='font-size:20px'&gt;Gaming Lakehouse: data axını (mənbədən dashboard-a qədər)&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;" vertex="1" parent="1"><mxGeometry x="340" y="40" width="1900" height="60" as="geometry"/></mxCell><mxCell id="n53" value="&lt;b&gt;Data haradan gəlir və necə dəyişir?&lt;/b&gt;&lt;br&gt;&lt;br&gt;1. &lt;b&gt;Mənbə:&lt;/b&gt; Python generator sintetik oyun event-ləri yaradır (5% çirkli, 2% schema drift) və source PostgreSQL-ə INSERT edir.&lt;br&gt;2. &lt;b&gt;CDC:&lt;/b&gt; Debezium Postgres WAL-ı oxuyur və hər sətri JSON zərfi ({before, after, op}) kimi Kafka topic-inə göndərir.&lt;br&gt;3. &lt;b&gt;Raw:&lt;/b&gt; Airflow consumer topic-dən oxuyub NDJSON faylları kimi RustFS-ə yazır, sonra ClickHouse raw cədvəlinə yükləyir (yalnız minimal tip çevrilməsi).&lt;br&gt;4. &lt;b&gt;Staging:&lt;/b&gt; dbt tipləri düzəldir, pozuq timestamp-i NULL edir (sətir atılmır), FINAL ilə dublikatı gizlədir.&lt;br&gt;5. &lt;b&gt;DQ:&lt;/b&gt; 4 yoxlama; uğursuzluqda run dayanır.&lt;br&gt;6. &lt;b&gt;Curated və serving:&lt;/b&gt; dim/fact qurulur, SQL view və CSV hesabat yayımlanır.&lt;br&gt;7. &lt;b&gt;İstehlak:&lt;/b&gt; Superset serving/staging/curated-i ClickHouse-dan HTTP ilə oxuyub dashboard göstərir." style="rounded=1;whiteSpace=wrap;html=1;fontSize=12;arcSize=12;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=11;align=left;spacing=6;verticalAlign=top;fontSize=12;" vertex="1" parent="1"><mxGeometry x="660" y="130" width="1580" height="220" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>