# Copy this file to .env and fill in real (still non-production) values before running docker compose.
# Never commit the real .env file.

# ---- Warehouse Postgres (raw / staging / curated schemas) ----
POSTGRES_USER=gaming_app
POSTGRES_PASSWORD=<CHANGE_ME>
POSTGRES_DB=gaming_lakehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Airflow metadata Postgres ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=<CHANGE_ME>
AIRFLOW_DB_NAME=airflow

# ---- Airflow core ----
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=<CHANGE_ME>
# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_WEBSERVER_SECRET_KEY=<CHANGE_ME>
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=<CHANGE_ME>

# ---- Source Postgres (OLTP-style table the generator writes into) ----
SOURCE_POSTGRES_USER=source_app
SOURCE_POSTGRES_PASSWORD=<CHANGE_ME>
SOURCE_POSTGRES_DB=gaming_source
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5433

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic name follows Debezium's convention: <topic.prefix>.<schema>.<table>
# (see infra/kafka-connect/postgres-source-connector.json)
KAFKA_TOPIC_GAME_EVENTS=gaming.source.game_events
# Generate with: python -c "import uuid,base64; print(base64.b64encode(uuid.uuid4().bytes).decode())"
KAFKA_CLUSTER_ID=<CHANGE_ME>

# ---- Kafka Connect (Debezium PostgreSQL source connector) ----
KAFKA_CONNECT_URL=http://localhost:8083

# ---- Spark (batch aggregation) ----
SPARK_MASTER_URL=spark://localhost:7077

# ---- RustFS (S3-compatible object storage, raw landing zone) ----
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=<CHANGE_ME>
RUSTFS_SECRET_KEY=<CHANGE_ME>
RUSTFS_RAW_BUCKET=raw-game-events

# ---- Synthetic data generator ----
GENERATOR_EVENTS_PER_SECOND=5
GENERATOR_DIRTY_RECORD_RATE=0.05
GENERATOR_SCHEMA_DRIFT_RATE=0.02
