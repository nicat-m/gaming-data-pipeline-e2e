# Copy this file to .env: `cp .env.example .env` - it runs as-is on a local machine.
# All values below are LOCAL DEVELOPMENT ONLY samples (not real secrets).
# Change them for any shared/hosted deployment. Never commit the real .env file.

# ---- Legacy warehouse Postgres vars (the warehouse is ClickHouse since Phase 2;
# kept only because compose still exposes them as an Airflow connection) ----
POSTGRES_USER=gaming_app
POSTGRES_PASSWORD=gaming_dev_pw
POSTGRES_DB=gaming_lakehouse
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# ---- Airflow metadata Postgres ----
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=airflow_dev_pw
AIRFLOW_DB_NAME=airflow

# ---- Airflow core ----
AIRFLOW_FERNET_KEY=D4g3b1PVl3Z69gc4pHsrMNmkFuLDVqQxS9OEPw7I_5E=
AIRFLOW_WEBSERVER_SECRET_KEY=96de2adc20693d89deca5102f4c46996
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin_dev_pw

# ---- Source Postgres (OLTP-style table the generator writes into) ----
SOURCE_POSTGRES_USER=source_app
SOURCE_POSTGRES_PASSWORD=source_dev_pw
SOURCE_POSTGRES_DB=gaming_source
SOURCE_POSTGRES_HOST=localhost
SOURCE_POSTGRES_PORT=5433

# ---- Kafka ----
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# Topic name follows Debezium's convention: <topic.prefix>.<schema>.<table>
# (see infra/kafka-connect/postgres-source-connector.json)
KAFKA_TOPIC_GAME_EVENTS=gaming.source.game_events
KAFKA_CLUSTER_ID=KiqtKOy7TYGUlQXCyub3fQ

# ---- Kafka Connect (Debezium PostgreSQL source connector) ----
KAFKA_CONNECT_URL=http://localhost:8083

# ---- Spark (batch aggregation) ----
SPARK_MASTER_URL=spark://localhost:7077

# ---- RustFS (S3-compatible object storage, raw landing zone) ----
RUSTFS_ENDPOINT_URL=http://localhost:9000
RUSTFS_ACCESS_KEY=rustfsdev
RUSTFS_SECRET_KEY=rustfsdev-secret-key
RUSTFS_RAW_BUCKET=raw-game-events

# ---- Synthetic data generator ----
GENERATOR_EVENTS_PER_SECOND=5
GENERATOR_DIRTY_RECORD_RATE=0.05
GENERATOR_SCHEMA_DRIFT_RATE=0.02

# ---- Phase 1 pipeline switches ----
# Deliberate failure demo: set to 1, `make up`, trigger the DAG -> the
# ingestion task raises and the whole run fails (see docs/evidence/phase-1.md).
# Keep 0 (or remove) for normal operation.
PIPELINE_FAIL_SWITCH=0
# Spark container the connectivity-proof task execs into (compose container_name).
SPARK_CONTAINER_NAME=gaming-spark-master

# ---- ClickHouse warehouse (replaces the old POSTGRES_* warehouse vars) ----
CLICKHOUSE_USER=gaming
CLICKHOUSE_PASSWORD=clickhouse_dev_pw
CLICKHOUSE_DB=gaming_lakehouse

# ---- Superset (analytic dashboard) ----
SUPERSET_SECRET_KEY=skMsEYCutt7afEAONm2vPyzDG9M6-gw-sbcL-9EUp-1_NgKHj0uz0A
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=superset_dev_pw
